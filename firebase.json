{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "functions/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/pwa{,.html}", "destination": "/about", "type": 301 },
      { "source": "/company{,.html}", "destination": "/about", "type": 301 },
      { "source": "/process{,.html}", "destination": "/apps", "type": 301 },
      { "source": "/portfolio{,.html}", "destination": "/apps", "type": 301 },
      { "source": "/pricing{,.html}", "destination": "/", "type": 301 }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
